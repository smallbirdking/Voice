{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice.local/schemas/sample-result.schema.json",
  "title": "ASR experiment per-sample raw result",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "environment_snapshot_id",
    "corpus",
    "input",
    "provider",
    "model",
    "configuration",
    "transcription",
    "timing",
    "outcome",
    "resource_sample_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "sample_result"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "environment_snapshot_id": {
      "type": "string",
      "pattern": "^env-sha256-[0-9a-f]{64}$"
    },
    "corpus": {
      "type": "object",
      "required": [
        "corpus_id",
        "corpus_version",
        "corpus_fingerprint",
        "reference_normalization_version"
      ],
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "corpus_fingerprint": {
          "type": "string",
          "pattern": "^corpus-sha256-[0-9a-f]{64}$"
        },
        "reference_normalization_version": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["sample_id", "language", "scenario", "audio"],
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "language": {
          "enum": ["zh-CN", "en-US", "zh-en", "none"]
        },
        "scenario": {
          "enum": ["general-speech", "long-form", "short-command", "silence", "noise-only"]
        },
        "audio": {
          "type": "object",
          "required": ["path", "sha256", "duration_ms", "format"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "type": "object",
              "required": ["container", "codec", "sample_rate_hz", "channels", "sample_width_bits"],
              "additionalProperties": false,
              "properties": {
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "codec": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_rate_hz": {
                  "type": "integer",
                  "minimum": 1
                },
                "channels": {
                  "type": "integer",
                  "minimum": 1
                },
                "sample_width_bits": {
                  "type": ["integer", "null"],
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["provider_id", "implementation_version", "runtime"],
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "object",
          "required": ["name", "version", "device"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["model_id", "revision", "artifact_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "artifact_fingerprint": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object"
    },
    "transcription": {
      "type": "object",
      "required": [
        "raw_text",
        "normalized_text",
        "normalization_version",
        "detected_language",
        "provider_payload"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "type": ["string", "null"]
        },
        "normalized_text": {
          "type": ["string", "null"]
        },
        "normalization_version": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
        },
        "detected_language": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "provider_payload": {}
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at",
        "monotonic_started_ns",
        "inference_started_ns",
        "inference_finished_ns",
        "monotonic_finished_ns",
        "inference_duration_ms",
        "total_duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$"
        },
        "finished_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$"
        },
        "monotonic_started_ns": {
          "type": "integer",
          "minimum": 0
        },
        "inference_started_ns": {
          "type": "integer",
          "minimum": 0
        },
        "inference_finished_ns": {
          "type": "integer",
          "minimum": 0
        },
        "monotonic_finished_ns": {
          "type": "integer",
          "minimum": 0
        },
        "inference_duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status", "process_exit_code", "error"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["succeeded", "failed", "timeout", "cancelled", "skipped"]
        },
        "process_exit_code": {
          "type": ["integer", "null"]
        },
        "error": {
          "type": ["object", "null"],
          "required": ["stage", "type", "code", "message", "retryable", "details"],
          "additionalProperties": false,
          "properties": {
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "resource_sample_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^resource-sample-[0-9]{6}$"
      }
    }
  }
}
