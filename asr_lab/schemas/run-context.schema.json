{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice.local/schemas/run-context.schema.json",
  "title": "ASR experiment run context",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "environment_snapshot_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "environment_snapshot_id": {
      "type": "string",
      "pattern": "^env-sha256-[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$"
    }
  },
  "additionalProperties": false
}
